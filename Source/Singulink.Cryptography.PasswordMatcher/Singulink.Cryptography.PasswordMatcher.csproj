<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Singulink.Cryptography</RootNamespace>
    <TargetFrameworks>netstandard2.0;net8.0;net8.0-windows10.0.19041;</TargetFrameworks>
    <NoWarn>$(NoWarn);CA1034</NoWarn>

    <Version>1.0.0</Version>
    <PackageTags>password; strength; blacklist; dictionary; match; nist</PackageTags>
    <Description>Detects passwords built entirely from common password words and contextual values such as your application name and the user's details, so that passwords vulnerable to dynamic dictionary attacks can be rejected with an explanation of which words they were built from.</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Collections.Immutable" Version="10.0.12" />
    <PackageReference Include="Singulink.Enums" Version="3.0.0" />
  </ItemGroup>
</Project>
